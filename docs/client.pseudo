# Messenger Client — Golden Standard
#
# This pseudo-code defines the canonical behavior for all Messenger client
# implementations. When implementing or fixing a client, compare your code
# against this file section by section.
#
# Conventions:
#   await  = asynchronous call
#   _ = operation() = start an asynchronous operation without blocking message
#                     dispatch; its returned task may be discarded
#   ->     = returns
#   //     = comment explaining WHY, not what
#
# Rules:
#   - Clients must NEVER call exit() or terminate the process. All errors
#     should be logged and handled gracefully. The client should always
#     attempt to continue running.
#     EXCEPTION 1 — decryption failure is fatal and non-recoverable. An AES
#     decrypt/unpad failure almost always means the encryption key is wrong,
#     so the client can never decrypt server traffic and is useless. On a
#     decryption failure the client logs a single distinctive error and
#     RETURNS from main() — a graceful stop, not exit()/abort — instead of
#     reconnecting in a loop that can never succeed.
#     EXCEPTION 2 — a CheckOutMessage (0x07) from the server is a kill
#     signal. On receipt, the client tears down all forwarders and TCP
#     clients, sets a `killed` flag, and lets start() return. The
#     reconnect loop checks `killed` and returns from main() instead of
#     retrying. Like decryption failure, this is a graceful return, not
#     exit()/abort.
#   - Status messages use bracketed prefixes: [+] success, [*] info, [!] error/warning.
#     Do not print transport names, debug details, or verbose diagnostics.
#   - Identifiers (client_id in RPF, etc.) must be 10-character alphanumeric
#     strings, not GUIDs/UUIDs.
#   - Hostnames passed to bind_tcp or TcpListener must be resolved via DNS
#     (e.g. Dns.GetHostAddresses, getaddrinfo) — do not require a numeric IP.
#   - Transport frames and the messages inside them are dispatched in received
#     order. Only request handlers that can wait on DNS/connect/bind are started
#     in the background. Replies, data, close, check-in, and checkout are handled
#     inline so Task/Thread scheduling cannot reorder them.
#   - Background tasks do not require a global registry. Each operation owns and
#     cleans up its resources in finally. Expected request failures are caught
#     when the protocol requires a failure reply; other task faults may remain
#     unobserved.


# ============================================================================
# 1. CONSTANTS & CONFIGURATION
# ============================================================================

# These are injected at build time via Jinja2 templates.
# Implementations should define them as module-level constants.

const SERVER_URL       = "{{ server_url }}"         # default: "localhost:8080"
const ENCRYPTION_KEY   = "{{ encryption_key }}"     # default: "" (empty — will error)
const USER_AGENT       = "{{ user_agent }}"         # default: browser-like UA string
const PROXY            = "{{ proxy }}"              # default: "" (none)
const RETRY_DURATION   = {{ retry_duration }}        # default: 60.0 (seconds)
const RETRY_ATTEMPTS   = {{ retry_attempts }}        # default: 5


# ============================================================================
# 2. CRYPTO
# ============================================================================

function hash(key_string) -> bytes:
    return SHA256(encode_utf8(key_string))
    // Always produces 32 bytes — AES-256 key size

function encrypt(key, plaintext) -> bytes:
    iv = random_bytes(16)
    padded = pkcs7_pad(plaintext, block_size=16)
    ciphertext = AES_CBC_encrypt(key, iv, padded)
    return iv || ciphertext

function decrypt(key, data) -> bytes:
    iv = data[0:16]
    ciphertext = data[16:]
    padded = AES_CBC_decrypt(key, iv, ciphertext)
    return pkcs7_unpad(padded)
    // Any failure here (bad AES key, bad PKCS7 padding) must surface as a
    // distinct DecryptionError type — NOT a generic parse/structural error —
    // so main() can tell "wrong key" apart from a malformed frame and halt.

// When encrypting an ArraySegment or Buffer slice, respect offset and count.
// Do NOT encrypt the entire backing array — only the active region.


# ============================================================================
# 3. WIRE FORMAT
# ============================================================================

# Message frame layout (big-endian):
#
#   +-------------------+-------------------+------------------+
#   | message_type (4B) | message_length (4B) |   payload ...   |
#   +-------------------+-------------------+------------------+
#
#   message_length includes the 8-byte header itself.
#   payload = message_length - 8 bytes.
#
# String encoding within payloads:
#
#   +--------------------+------------------+
#   | string_length (4B) |  UTF-8 bytes ... |
#   +--------------------+------------------+
#
# Multiple messages may be concatenated in a single transport frame.

function serialize_message(message, encryption_key) -> bytes:
    payload = build_payload(message)

    if message.type not in (CHECK_IN, CHECK_OUT):
        payload = encrypt(encryption_key, payload)

    type_bytes  = uint32_to_bytes_be(message.type_id)
    length      = 8 + length(payload)
    length_bytes = uint32_to_bytes_be(length)
    return type_bytes || length_bytes || payload

function deserialize_messages(raw_data, encryption_key) -> list[message]:
    messages = []
    while length(raw_data) >= 8:
        message_type   = bytes_to_uint32_be(raw_data[0:4])
        message_length = bytes_to_uint32_be(raw_data[4:8])

        if message_length < 8:
            error("Invalid message: length field too small")
            // Prevents underflow when computing payload_length

        if message_length > length(raw_data):
            break  // incomplete frame — wait for more data

        payload  = raw_data[8 : message_length]
        raw_data = raw_data[message_length :]

        if message_type not in (CHECK_IN, CHECK_OUT):
            payload = decrypt(encryption_key, payload)
            // decrypt() raises DecryptionError on a bad key — let it
            // propagate uncaught, past the receive/poll loop, out of
            // start(), all the way to main()'s DecryptionError handler.
            // Do NOT catch it here or swallow it as a generic parse error.

        messages.append(parse_payload(message_type, payload))

    return messages


# ============================================================================
# 4. MESSAGE TYPES
# ============================================================================

# Type IDs:
#   0x01 = InitiateTCPClientReq    (encrypted)
#   0x02 = InitiateTCPClientRep    (encrypted)
#   0x03 = SendDataMessage               (encrypted)
#   0x04 = CheckInMessage                (NOT encrypted)
#   0x05 = InitiateBINDReq               (encrypted)
#   0x06 = InitiateBINDRep               (encrypted)
#   0x07 = CheckOutMessage               (NOT encrypted, empty payload)

struct CheckInMessage:
    messenger_id: string

struct InitiateTCPClientReq:
    client_id: string
    destination_host: string
    destination_port: uint32
    listening_host: string  # optional — a remote port forwarder appends the
    listening_port: uint32  # listening endpoint it came through, so the server
                            # maps the connection to the exact RPF (not by dest).
                            # Absent for server-initiated (SOCKS/local) requests.

struct InitiateTCPClientRep:
    client_id: string
    bind_address: string
    bind_port: uint32
    address_type: uint32    # 1 = IPv4, 4 = IPv6
    reason: uint32          # 0 = success, see error mapping for others
    remote_addr: string     # optional — absent in older implementations
    remote_port: uint32     # optional — absent in older implementations

struct SendDataMessage:
    client_id: string
    data: bytes             # empty data = immediately RST this TCP client

struct InitiateBINDReq:
    bind_id: string
    listening_host: string  # SENTINEL: "" (empty) = STOP this bind (teardown).
    listening_port: uint32  #   A real host = create/bind this RPF.
    destination_host: string
    destination_port: uint32

struct InitiateBINDRep:
    bind_id: string
    listening_host: string  # always the real listening endpoint, even on failure
    listening_port: uint32
    reason: uint32          # 0 = success/confirmed; non-zero = GONE (bind failed,
                            #   crashed, or torn down)

struct CheckOutMessage:
    # Empty payload. Server -> client only. Tells the client to tear down
    # all forwarders and TCP clients, then return from main() without
    # reconnecting.

# ---------------------------------------------------------------------------
# REMOTE PORT FORWARD (BIND) LIFECYCLE
# ---------------------------------------------------------------------------
# The client is the ground truth for what is actually listening (the listener
# physically lives on it). The server keeps a per-connection cache and
# reconciles to the client.
#
#   server -> client   InitiateBINDReq
#       listening_host = real  -> create + bind (idempotent if already held)
#       listening_host = ""    -> STOP: tear down that bind_id (kill its
#                                 forwarded connections + close the listener)
#
#   client -> server   InitiateBINDRep  (always carries the real host:port)
#       reason == 0  -> "I'm listening": server confirms it, or (if the
#                       bind_id is unknown) stores an ORPHAN with an EMPTY
#                       destination — it never routes until the operator
#                       re-runs `remote` to set the dest. A reason-0 BindRep
#                       for a listening endpoint the server holds under a
#                       DIFFERENT bind_id replaces that stale entry (client
#                       wins).
#       reason != 0  -> GONE: server removes the forwarder and RSTs its
#                       connections. Covers bind failure, listener crash,
#                       and the reply to a stop.
#
# A forwarded connection carries its listening endpoint in InitiateTCPClientReq,
# so the server routes it to the exact RPF and connects to that RPF's
# operator-configured destination (an orphan with no destination is denied).

# SendDataMessage payload format:
#   client_id (length-prefixed string)
#   data encoded as base64 string (length-prefixed)
#
# The base64 encoding happens INSIDE the encrypted envelope.


# ============================================================================
# 5. CLIENT (BASE CLASS)
# ============================================================================

class TcpConnection:
    messenger: Client
    client_id: string
    bind_id: string | null
    socket: socket
    write_queue: ordered_async_queue<bytes>

    function constructor(messenger, client_id, socket, bind_id=null):
        self.messenger = messenger
        self.client_id = client_id
        self.bind_id = bind_id
        self.socket = socket
        self.write_queue = new ordered_async_queue()

    function abort() -> bool:
        if messenger.tcp_clients.remove(client_id, self) failed:
            return false
            // Dictionary removal is the once-only abort guard. Every other
            // path becomes a no-op, so no separate closed flag is needed.

        write_queue.complete()
        close_socket(socket)         // close without blocking dispatch
        return true

    function abort_and_signal():
        if abort() and not messenger.killed:
            _ = messenger.send_upstream_message(
                SendDataMessage(client_id=client_id, data=empty))

    function send_data(data):
        if data is empty:
            abort()
            // Empty SendData is the protocol command to RST this TCP client.
        else:
            write_queue.try_enqueue(data)
            // Failure means abort() completed the queue after the dispatcher
            // found this connection. The data is obsolete; ignore it.
        // Data is enqueued inline in wire order. An empty message aborts
        // immediately rather than waiting behind queued writes.

    function write_loop():
        try:
            while true:
                data = await write_queue.dequeue()
                write(socket, data)
                await drain(socket)
        catch (QueueClosed):
            pass
        catch:
            abort_and_signal()

    function stream():
        try:
            while true:
                data = await read(socket, max=4096)
                if data is empty:
                    break
                await messenger.send_upstream_message(
                    SendDataMessage(client_id=client_id, data=data))
        catch (EOF, ConnectionReset, ConnectionAborted):
            pass
        catch:
            pass
        finally:
            abort_and_signal()


class Client:
    identifier: string = ""
    tcp_clients: concurrent_dict<string, TcpConnection>
    remote_port_forwarders: concurrent_list<RemotePortForwarder>
    encryption_key: bytes
    killed: bool = false

    function register_tcp_client(client_id, socket, bind_id=null) -> TcpConnection | null:
        if killed:
            abort_socket(socket)
            return null

        connection = new TcpConnection(self, client_id, socket, bind_id)
        if tcp_clients.try_add(client_id, connection) failed:
            abort_socket(socket)
            return null

        if killed:
            connection.abort()
            return null
            // Closes the narrow race where checkout occurs between the first
            // killed check and publication in the dictionary.

        _ = connection.write_loop()
        return connection

    function close_connections_for_bind(bind_id):
        for connection in snapshot(tcp_clients.values):
            if connection.bind_id == bind_id:
                connection.abort()
        // Forwarder shutdown is rare, so a scan avoids maintaining a second
        // connection collection that must stay synchronized with tcp_clients.

    function dispatch_message(message):
        # Called sequentially by the transport receive/poll loop. Do not wrap
        # this whole function in Task.Run/spawn: that would discard wire order.
        match message.type:

            InitiateTCPClientReq:
                # DNS and connect can take seconds, so this request is the one
                # operation that must not hold up dispatch for other clients.
                _ = handle_tcp_connect(
                    message.client_id,
                    message.destination_host,
                    message.destination_port
                )

            InitiateTCPClientRep:
                connection = tcp_clients.get(message.client_id)
                if connection is null:
                    return

                if message.reason != 0:
                    connection.abort()
                    return

                resume(connection.socket)
                // The RPF socket was registered and paused before its request.
                // A successful reply is the protocol gate that starts reading.
                _ = connection.stream()

            SendDataMessage:
                connection = tcp_clients.get(message.client_id)
                if connection is null:
                    return

                connection.send_data(message.data)

            InitiateBINDReq:
                # DNS/bind is a request and may be slow. RemotePortForwarder.start
                # returns after starting its owned accept loop; it never awaits
                # the lifetime of that loop.
                _ = handle_bind(
                    message.bind_id,
                    message.listening_host,
                    message.listening_port,
                    message.destination_host,
                    message.destination_port
                )

            CheckInMessage:
                identifier = message.messenger_id

            CheckOutMessage:
                handle_checkout()


    function handle_checkout():
        log("[!] Kill signal received")
        killed = true
        // This is an inline shutdown barrier. Once it is reached, the receive
        // loop dispatches nothing after it. Closing listeners, sockets, and
        // queues wakes their accept, read, write, and dequeue operations.

        for forwarder in snapshot(remote_port_forwarders):
            forwarder.stop()

        for connection in snapshot(tcp_clients.values):
            connection.abort()
        // Checkout requests closure only. TcpConnection.abort owns dictionary
        // removal/queue/socket cleanup; the forwarder's accept-loop finally
        // owns forwarder removal and cleanup of its accepted clients.


    function handle_bind(bind_id, listening_host, listening_port, destination_host, destination_port):
        if killed:
            return

        # Empty listening host is an unambiguous STOP request.
        if listening_host == "":
            existing = find remote_port_forwarders where identifier == bind_id
            if existing is not null:
                existing.stop()
            return

        # A duplicate real BindReq is idempotent, not a shutdown.
        if remote_port_forwarders has one where identifier == bind_id:
            await send_upstream_message(InitiateBINDRep(
                bind_id = bind_id, listening_host = listening_host,
                listening_port = listening_port, reason = 0))
            return

        try:
            forwarder = new RemotePortForwarder(
                self, bind_id, listening_host, listening_port,
                destination_host, destination_port
            )
            success = await forwarder.start()
            if not success:
                if not killed:
                    await send_upstream_message(InitiateBINDRep(
                        bind_id = bind_id, listening_host = listening_host,
                        listening_port = listening_port, reason = 1))
                return

            if killed:
                forwarder.stop()
                return
                // Checkout may have occurred while DNS/bind was in progress.
                // Never publish a listener after the shutdown barrier.

            await send_upstream_message(InitiateBINDRep(
                bind_id = bind_id, listening_host = listening_host,
                listening_port = listening_port, reason = 0))

        catch error:
            if not killed:
                await send_upstream_message(InitiateBINDRep(
                    bind_id = bind_id, listening_host = listening_host,
                    listening_port = listening_port, reason = 1))


    function handle_tcp_connect(client_id, host, port):
        # Maps OS-level socket errors to SOCKS5 reason codes. This whole
        # function is an owned background request task, so awaiting its stream
        # does not block message dispatch.
        if killed:
            return

        raw_socket = null
        connection = null

        try:
            addresses = await resolve_hostname(host)
            raw_socket = new Socket(address_family_for(addresses))
            await connect(raw_socket, addresses, port, timeout=5_seconds)

            if killed:
                abort_socket(raw_socket)
                raw_socket = null
                return
                // A connect started before checkout must not publish afterward.

            connection = register_tcp_client(client_id, raw_socket)
            if connection is null:
                raw_socket = null     // register closed the duplicate socket
                if not killed:
                    await send_upstream_message(InitiateTCPClientRep(
                        client_id = client_id,
                        bind_address = "0.0.0.0", bind_port = 0,
                        address_type = 1, reason = 1,
                        remote_addr = "0.0.0.0", remote_port = 0
                    ))
                return
            raw_socket = null         // ownership transferred to connection

            reply = InitiateTCPClientRep(
                client_id    = client_id,
                bind_address = connection.socket.local_address,
                bind_port    = connection.socket.local_port,
                address_type = 1 if IPv4 else 4 if IPv6,
                reason       = 0,
                remote_addr  = connection.socket.remote_address,
                remote_port  = connection.socket.remote_port
            )
            await send_upstream_message(reply)
            await connection.stream()
            // This responder starts reading immediately. Any resulting data is
            // enqueued after the reply, so the ordered transport delivers the
            // reply before that data. The requester does not start its own read
            // loop until it receives and processes the successful reply.

        catch error:
            if not killed:
                await send_upstream_message(InitiateTCPClientRep(
                    client_id = client_id,
                    bind_address = "0.0.0.0", bind_port = 0,
                    address_type = 1, reason = map_socket_error(error),
                    remote_addr = "0.0.0.0", remote_port = 0
                ))
        finally:
            if connection is not null:
                connection.abort()
                // Handles failure after registration but before/during stream.
                // If stream already cleaned up, dictionary removal makes this
                // a harmless no-op.
            if raw_socket is not null:
                abort_socket(raw_socket)


    # Error-to-SOCKS5-reason mapping:
    #   DNS failure / resolution error  -> 0x04 (host unreachable)
    #   Timeout                         -> 0x06 (TTL expired)
    #   Connection refused              -> 0x05
    #   Network unreachable             -> 0x03
    #   Host unreachable                -> 0x04
    #   Address family not supported    -> 0x08
    #   Protocol not available          -> 0x07
    #   General / unknown               -> 0x01


    function send_upstream_message(message):
        # Abstract — implemented by WSClient and HTTPClient. It enqueues; it
        # does not wait for an HTTP response or write a WebSocket directly.
        raise NotImplemented


# ============================================================================
# 6. WebSocket CLIENT
# ============================================================================

class WSClient extends Client:
    websocket: WebSocket
    upstream_queue: concurrent_queue<message>

    function connect():
        websocket = await open_websocket(url, headers={User-Agent: user_agent}, tls_verify=false)

        # Check-in: identify ourselves to the server.
        checkin = CheckInMessage(messenger_id=self.identifier)
        await websocket.send_binary(serialize_message(checkin, encryption_key))

        if self.identifier is not empty:
            return
            // Reconnection — server already knows us. No need to wait
            // for a new ID assignment.

        # First connect — read the server's ID assignment.
        response_bytes = await receive_full_message(websocket)
        // Must handle fragmented WebSocket frames:
        //   loop { recv; append to buffer } until EndOfMessage flag is set
        // A single ReceiveAsync may not contain the full server response.

        messages = deserialize_messages(response_bytes, encryption_key)
        assert length(messages) > 0
        assert messages[0] is CheckInMessage
        self.identifier = messages[0].messenger_id

    function start():
        # SINGLE-WRITER SEND RULE
        #
        # A WebSocket connection is one ordered byte stream. Sending a message is
        # NOT atomic (it can span multiple awaits / transport writes), so two
        # overlapping sends corrupt the frame on the wire. Therefore EXACTLY ONE
        # task may ever write to the socket. All sends flow through a single
        # send_loop that drains a queue; producers only enqueue (see
        # send_upstream_message). Never call send_binary from multiple tasks.
        #
        # This is a correctness requirement, not an optimization:
        #   - C# ClientWebSocket ABORTS the socket on an overlapping SendAsync.
        #   - A raw async socket writer interleaves frame bytes silently.
        #   - Some libraries serialize internally (e.g. Node's `ws` buffers
        #     sends); on those, sending immediately from send_upstream_message
        #     is equivalent and acceptable — the library IS the single writer.
        #
        # Messages queued while disconnected are drained by the send_loop on
        # (re)connect, so no separate startup drain step is required.
        await parallel(receive_loop(), send_loop())

    function receive_loop():
        while websocket.is_open:
            frame_bytes = await receive_full_message(websocket)
            // Again: accumulate fragments until EndOfMessage.

            if received_close:
                break

            messages = deserialize_messages(frame_bytes, encryption_key)

            // CheckOut overrides the entire frame. Do not dispatch messages
            // that appeared before or after it in the same decoded batch.
            if any message in messages is CheckOutMessage:
                handle_checkout()
                break

            for message in messages:
                dispatch_message(message)
                // dispatch_message starts only slow request work in the
                // background. Replies, data, and close finish inline in the
                // order they appeared in this frame.

        // On exit (close/error), signal the send_loop so it wakes and stops —
        // otherwise parallel() hangs on a send_loop parked waiting for a message.
        signal_send_loop_to_stop()

    function send_loop():
        # THE single writer. Wake on a SIGNAL, not a poll: park until a message
        # is enqueued (semaphore / channel / async queue). Parking costs no CPU
        # when idle AND adds no latency when a message arrives. A fixed
        # sleep(10ms) poll also works but taxes every send up to ~10ms — prefer
        # the signal.
        while not cancelled:
            await wait_for_send_signal()      // parks until an enqueue or cancel
            if cancelled or websocket is not open:
                break

            batch = [CheckInMessage(messenger_id=self.identifier)]
            while upstream_queue is not empty:
                batch.append(upstream_queue.dequeue())
                // Coalesce everything queued right now into one frame.

            if batch contains only the CheckIn:
                continue                      // surplus wake — nothing to send

            payload = serialize_messages(batch, encryption_key)
            await websocket.send_binary(payload)

    function send_upstream_message(message):
        # Producer only — NEVER writes the socket. Enqueue and wake the loop.
        # (A library that serializes internally may instead send immediately.)
        upstream_queue.enqueue(message)
        signal_send_loop()
        // Drained by the send_loop while connected, or on the next reconnect.


# ============================================================================
# 7. HTTP CLIENT
# ============================================================================

class HTTPClient extends Client:
    http_client: HttpClient    # reuse a SINGLE client/agent — do not create per-request
    upstream_queue: concurrent_queue<message>

    function connect():
        checkin = CheckInMessage(messenger_id=self.identifier)
        payload = serialize_message(checkin, encryption_key)
        response = await http_post(url, payload, timeout=10s)
        assert_http_success(response)

        if self.identifier is not empty:
            return

        messages = deserialize_messages(response.body, encryption_key)
        assert length(messages) > 0
        assert messages[0] is CheckInMessage
        self.identifier = messages[0].messenger_id

    pending: list<message>     # persists across reconnects — field, not local

    function start():
        # Polling loop — blocks until an error triggers reconnection.
        while true:
            if pending is empty:
                drain up to 5 messages from upstream_queue into pending

            batch = [CheckInMessage(messenger_id=self.identifier)]
            batch.extend(pending)

            payload = serialize_messages(batch, encryption_key)
            response = await http_post(url, payload, timeout=15s)

            if response is not success:
                throw HttpError(response.status)
                // MUST throw, not break.
                // A break kills the poll loop permanently — no reconnection.
                // A throw unwinds to the reconnection logic in main().
                // pending is NOT cleared — retried on reconnect.

            pending.clear()

            if response.body is not empty:
                messages = deserialize_messages(response.body, encryption_key)

                // CheckOut overrides the entire response batch. Discard every
                // other message returned with it, regardless of position.
                if any message in messages is CheckOutMessage:
                    handle_checkout()
                    break

                for message in messages:
                    dispatch_message(message)

            await sleep(100ms)
            // Poll interval. Implementations may vary (100ms-1000ms).

    function send_upstream_message(message):
        upstream_queue.enqueue(message)
        // Never send immediately — the polling loop handles all sends.


# ============================================================================
# 8. REMOTE PORT FORWARDER
# ============================================================================

class RemotePortForwarder:
    messenger: Client
    identifier: string
    server: tcp_listener
    listening_host: string
    listening_port: int
    destination_host: string
    destination_port: int

    function constructor(messenger, identifier, listening_host, listening_port, destination_host, destination_port):
        self.messenger        = messenger
        self.identifier       = identifier
        self.listening_host   = listening_host
        self.listening_port   = listening_port
        self.destination_host = destination_host
        self.destination_port = destination_port

    function start():
        try:
            address = await resolve_hostname(listening_host)
            server = bind_tcp(address, listening_port)
        catch bind_error:
            log("[!] {host}:{port} is already in use or encountered an error")
            return false

        if messenger.killed:
            server.close()
            return false

        messenger.remote_port_forwarders.append(self)
        // Publish before starting the accept loop. From this point forward the
        // forwarder owns its cleanup and list removal.
        _ = accept_loop()
        return true
        // start() returns after the listener is live. It never waits for the
        // lifetime of the accept loop, so handle_bind can send its BindRep.

    function accept_loop():
        try:
            while server is open:
                accepted_socket = await server.accept()
                _ = handle_client(accepted_socket)
        catch (ListenerClosed):
            pass
        finally:
            await cleanup()

    function cleanup():
        if messenger.remote_port_forwarders.remove(self) failed:
            return
            // List removal is the once-only cleanup guard. stop() never removes
            // the forwarder; it closes the listener and this finally owns the
            // rest of the forwarder's cleanup.

        messenger.close_connections_for_bind(identifier)

        if not messenger.killed:
            await messenger.send_upstream_message(InitiateBINDRep(
                bind_id = self.identifier, listening_host = self.listening_host,
                listening_port = self.listening_port, reason = 1))

    function stop():
        if server is not null:
            server.close()
            // If closing the listener causes the accept loop to exit
            // immediately (e.g. C# AcceptTcpClientAsync throws, Python
            // serve_forever returns), the accept loop's finally will
            // trigger cleanup — do not call it here.
            // If the runtime defers listener teardown until existing
            // connections close on their own (e.g. Node.js server.close()),
            // those connections will never close because cleanup is what
            // closes them. In that case, call cleanup() explicitly here.
        cleanup()              // omit if accept_loop's finally is immediate

    function handle_client(accepted_socket):
        if messenger.killed OR self not in messenger.remote_port_forwarders:
            abort_socket(accepted_socket)
            return

        client_id = alphanumeric_identifier(10)

        connection = messenger.register_tcp_client(
            client_id,
            accepted_socket,
            bind_id = self.identifier
        )
        if connection is null:
            return

        if self not in messenger.remote_port_forwarders:
            connection.abort()
            return
        // Register BEFORE sending the request.
        // The server may respond before the send completes — the reply
        // handler needs the dictionary entry to exist.

        pause(accepted_socket)
        // Do NOT read data from the accepted socket yet.
        // Wait for the server to approve the connection (reason=0 in
        // InitiateTCPClientRep). Data arriving before approval
        // would be lost because no stream() task is running yet.

        request = InitiateTCPClientReq(
            client_id      = client_id,
            destination_host = destination_host,
            destination_port = destination_port,
            listening_host = self.listening_host,   # so the server maps this
            listening_port = self.listening_port    # connection to THIS exact RPF
        )
        await messenger.send_upstream_message(request)

        // Stream is NOT started here. The dispatch_message handler for
        // InitiateTCPClientRep (reason=0) resumes the socket and
        // starts stream(). If the server denies (reason!=0), the socket
        // is removed and RST there.

        // Messenger owns the connection in its global map. bind_id associates
        // it with this RPF so cleanup can close the group without a second list.


# ============================================================================
# 9. ARG PARSING
# ============================================================================

function parse_args(argv) -> dict:
    # All clients support the same flags:
    #   --server-url VALUE
    #   --encryption-key VALUE
    #   --user-agent VALUE
    #   --proxy VALUE
    #   --retry-duration VALUE
    #   --retry-attempts VALUE
    #
    # Unknown flags print a warning but do not abort.

    parsed = {}
    i = 0
    while i < length(argv):
        flag = argv[i]
        match flag:
            "--server-url":       parsed.server_url      = argv[++i]
            "--encryption-key":   parsed.encryption_key   = argv[++i]
            "--user-agent":       parsed.user_agent       = argv[++i]
            "--proxy":            parsed.proxy            = argv[++i]
            "--retry-duration":   parsed.retry_duration   = parse_float(argv[++i])
            "--retry-attempts":   parsed.retry_attempts   = parse_int(argv[++i])
            default:
                log("[!] Could not find argument `{flag}`.")
        i++

    return parsed


function apply_config(parsed) -> config:
    # CLI args override hardcoded values. Hardcoded values override defaults.
    #
    # IMPORTANT: For string values, use truthiness (empty string = use default).
    # For numeric values, use IS NOT NULL (0 is a valid override — it disables retries).

    config.server_url      = parsed.server_url      OR SERVER_URL
    config.encryption_key  = parsed.encryption_key  OR ENCRYPTION_KEY
    config.user_agent      = parsed.user_agent      OR USER_AGENT
    config.proxy           = parsed.proxy           OR PROXY

    # If a proxy was requested but the platform has no native proxy support,
    # warn and clear the value rather than silently ignoring it.
    if config.proxy is not empty AND NOT platform_supports_proxies():
        log("[!] No native support for proxies.")
        config.proxy = ""

    config.retry_duration  = parsed.retry_duration  IF NOT NULL ELSE RETRY_DURATION
    config.retry_attempts  = parsed.retry_attempts  IF NOT NULL ELSE RETRY_ATTEMPTS

    if config.encryption_key is empty:
        log("[!] No encryption key provided, please specify one with --encryption-key.")
        return null

    config.encryption_key = hash(config.encryption_key)
    return config


# ============================================================================
# 10. MAIN
# ============================================================================

function main():
    args = parse_args(command_line_arguments)
    config = apply_config(args)

    disable_tls_certificate_validation()
    // All transports accept self-signed certs. This is intentional —
    // Messenger is deployed in pentest environments where cert chains
    // are not available.

    # --- Scheme splitting ---
    url = config.server_url.trim("/")
    if url contains "://":
        parts = split(url, "://", limit=2)
        schemes = split(parts[0], "+")
        host = parts[1]
    else:
        schemes = ["ws", "wss", "http", "https"]
        host = url

    # --- Transport selection ---
    client = null
    for scheme in schemes:
        candidate_url = "{scheme}://{host}"

        if scheme contains "ws":
            client = new WSClient(candidate_url, config)
        else if scheme contains "http":
            client = new HTTPClient(candidate_url, config)
        else:
            log("[!] Unsupported scheme: {scheme}")
            continue

        try:
            await client.connect()
            log("[+] Connected to {candidate_url}")
            break
        catch DecryptionError:
            log("[!] Decryption failed — the encryption key is likely incorrect. "
                "The messenger cannot decrypt server traffic and is stopping.")
            return
            // Fatal: a wrong key fails identically on every scheme and every
            // reconnect, so do NOT try the next scheme or enter retry logic.
        catch error:
            log("[!] Connection failed: {error}")
            client = null
            continue                # try next scheme

    if client is null:
        log("[!] All connection attempts failed.")
        return

    # --- Initial start ---
    # start() blocks until disconnect. Separated from connect() so a
    # start() failure falls through to the retry loop instead of
    # being mistaken for a connection failure.
    try:
        await client.start()
    catch DecryptionError:
        log("[!] Decryption failed — the encryption key is likely incorrect. "
            "The messenger cannot decrypt server traffic and is stopping.")
        return
    catch error:
        log("[!] Disconnected: {error}")

    if client.killed:
        return

    # --- Reconnection ---
    if config.retry_attempts <= 0:
        return

    sleep_interval = config.retry_duration / config.retry_attempts
    consecutive_failures = 0

    while consecutive_failures < config.retry_attempts:
        consecutive_failures += 1
        log("[*] Attempting to reconnect (attempt {consecutive_failures}/{config.retry_attempts})")
        await sleep(sleep_interval)

        try:
            cleanup_transport(client)
            // Cancel send loops, dispose old WebSocket/HTTP client.
            // Create fresh transport internals.
            //
            // What MUST be cleaned up:
            //   - Cancel tokens / stop send loops
            //   - Dispose old transport (WebSocket, HTTP client)
            //
            // What MUST persist across reconnect:
            //   - client.identifier (server uses it to recognize us)
            //   - client.tcp_clients (tunnels may still be alive)
            //   - remote_port_forwarders (server-initiated RPF listeners)
            //   - upstream message queue (messages queued during disconnect)

            await client.connect()
            log("[+] Reconnected")
            consecutive_failures = 0
            // Reset on success — allows infinite reconnections as long as
            // each connection succeeds at least once.

            await client.start()    # blocks until next disconnect

        catch DecryptionError:
            log("[!] Decryption failed — the encryption key is likely incorrect. "
                "The messenger cannot decrypt server traffic and is stopping.")
            return
            // Fatal: reconnecting cannot fix a wrong key. Stop the loop.
        catch error:
            log("[!] Reconnection failed: {error}")

        if client.killed:
            return
